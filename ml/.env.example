# Model service configuration. Copy to .env and adjust as needed.
# Every value is optional; the defaults are used when a variable is unset.

# Default provider used when a request omits "model" ("baseline" | "huggingface").
PHISHLENS_DEFAULT_MODEL=baseline

# Hugging Face checkpoint id for the "huggingface" provider.
PHISHLENS_HF_MODEL_ID=jagan-raj/PhishMail

# Root log level: DEBUG | INFO | WARNING | ERROR.
PHISHLENS_LOG_LEVEL=INFO